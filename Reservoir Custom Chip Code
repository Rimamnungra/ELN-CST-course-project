}

// ============================================================
// WATER
// ============================================================

static void draw_water(chip_state_t *chip) {

    float percentage =
        chip->volume / TANK_CAPACITY;

    if (percentage < 0.0f) percentage = 0.0f;
    if (percentage > 1.0f) percentage = 1.0f;

    const int left = 29;
    const int right = 122;
    const int top = 77;
    const int bottom = 172;

    int tank_height = bottom - top;

    int surface_y =
        bottom - (int)(percentage * tank_height);

    if (percentage <= 0.0f) {
        return;
    }

    for (int y = surface_y; y <= bottom; y++) {

        float depth =
            (float)(y - surface_y) /
            (float)(bottom - surface_y + 1);

        uint32_t water_color;

        if (depth < 0.35f) {
            water_color = WATER_TOP;
        } else if (depth < 0.70f) {
            water_color = WATER_MID;
        } else {
            water_color = WATER_BOTTOM;
        }

        for (int x = left; x <= right; x++) {

            float wave =
                1.5f * sinf(
                    (float)x * 0.12f +
                    chip->wave_phase
                );

            int adjusted_surface =
                surface_y + (int)wave;

            if (y >= adjusted_surface) {
                draw_pixel(x, y, water_color);
            }
        }
    }

    // Water surface highlight
    for (int x = left; x <= right; x++) {

        float wave =
            1.5f * sinf(
                (float)x * 0.12f +
                chip->wave_phase
            );

        int y = surface_y + (int)wave;

        draw_pixel(x, y, WATER_HIGHLIGHT);
    }

    // Reflection
    if (percentage > 0.20f) {

        int reflection_y =
            surface_y +
            (int)((bottom - surface_y) * 0.35f);

        draw_line(
            48, reflection_y,
            85, reflection_y,
            COLOR(130, 220, 255, 255)
        );
    }
}

// ============================================================
// WATER LEVEL SCALE
// ============================================================

static void draw_level_scale(void) {

    const int positions[5] = {
        77, 101, 125, 149, 172
    };

    const char *labels[5] = {
        "100", "75", "50", "25", "0"
    };

    for (int i = 0; i < 5; i++) {

        int y = positions[i];

        draw_line(
            132, y,
            138, y,
            FRAME_LIGHT
        );

        draw_text_scaled(
            140, y - 2,
            labels[i],
            GREY,
            1
        );
    }
}

// ============================================================
// STATUS INDICATORS
// ============================================================

static void draw_status(chip_state_t *chip) {

    bool irrigation =
        pin_read(chip->irrigation_pin);

    bool refill =
        pin_read(chip->refill_pin);

    draw_rect(
        8, 196, 76, 216,
        PANEL_COLOR
    );

    draw_rect(
        83, 196, 151, 216,
        PANEL_COLOR
    );

    draw_rect(
        13, 202, 20, 209,
        irrigation ? GREEN : RED
    );

    draw_rect(
        88, 202, 95, 209,
        refill ? GREEN : RED
    );

    draw_text_scaled(
        23, 203,
        irrigation ? "IRR ON" : "IRR OFF",
        WHITE,
        1
    );

    draw_text_scaled(
        98, 203,
        refill ? "REF ON" : "REF OFF",
        WHITE,
        1
    );
}

// ============================================================
// COMPLETE DISPLAY RENDERING
// ============================================================

static void draw_reservoir(chip_state_t *chip) {

    // Calculate scaling factors.
    scale_x_factor =
        (float)chip->width / BASE_WIDTH;

    scale_y_factor =
        (float)chip->height / BASE_HEIGHT;

    render_width = chip->width;
    render_height = chip->height;

    // Clear display.
    draw_rect(
        0, 0,
        BASE_WIDTH - 1,
        BASE_HEIGHT - 1,
        BG_COLOR
    );

    // Draw all elements.
    draw_header(chip);

    draw_tank_frame();

    draw_water(chip);

    // Draw tank edges over water.
    draw_line(24, 70, 127, 70, FRAME_LIGHT);
    draw_line(24, 70, 24, 178, FRAME_LIGHT);
    draw_line(128, 71, 128, 178, FRAME_DARK);
    draw_line(24, 179, 128, 179, FRAME_DARK);

    draw_level_scale();

    draw_status(chip);

    // Update framebuffer.
    buffer_write(
        chip->framebuffer,
        0,
        pixels,
        render_width * render_height * sizeof(uint32_t)
    );
}

// ============================================================
// RESERVOIR SIMULATION
// ============================================================

static void update_reservoir(chip_state_t *chip) {

    uint64_t current_time = get_sim_nanos();

    float elapsed_seconds =
        (float)(current_time - chip->last_update) /
        1000000000.0f;

    chip->last_update = current_time;

    bool irrigation =
        pin_read(chip->irrigation_pin);

    bool refill =
        pin_read(chip->refill_pin);

    float inflow = 0.0f;
    float outflow = 0.0f;

    if (refill) {
        inflow = REFILL_RATE;
    }

    if (irrigation) {
        outflow = IRRIGATION_RATE;
    }

    // Convert L/min to L/s.
    float net_flow =
        (inflow - outflow) / 60.0f;

    chip->volume +=
        net_flow * elapsed_seconds;

    // Enforce tank limits.
    if (chip->volume > TANK_CAPACITY) {
        chip->volume = TANK_CAPACITY;
    }

    if (chip->volume < 0.0f) {
        chip->volume = 0.0f;
    }

    // Animate water.
    chip->wave_phase += 0.08f;

    if (chip->wave_phase > 6.28318f) {
        chip->wave_phase -= 6.28318f;
    }

    // Convert volume percentage to voltage.
    float level_percentage =
        chip->volume / TANK_CAPACITY;

    float output_voltage =
        level_percentage * LEVEL_MAX_VOLTAGE;

    pin_dac_write(
        chip->level_pin,
        output_voltage
    );

    draw_reservoir(chip);
}

// ============================================================
// TIMER CALLBACK
// ============================================================

static void timer_callback(void *user_data) {

    chip_state_t *chip =
        (chip_state_t *)user_data;

    update_reservoir(chip);
}

// ============================================================
// CHIP INITIALIZATION
// ============================================================

void chip_init(void) {

    chip_state_t *chip =
        (chip_state_t *)malloc(sizeof(chip_state_t));

    if (!chip) {
        return;
    }

    // Initialize pins.
    chip->irrigation_pin =
        pin_init("IRRIGATION", INPUT_PULLDOWN);

    chip->refill_pin =
        pin_init("REFILL", INPUT_PULLDOWN);

    chip->level_pin =
        pin_init("LEVEL", ANALOG);

    // Initialize reservoir state.
    chip->volume = INITIAL_VOLUME;

    chip->wave_phase = 0.0f;

    chip->last_update = get_sim_nanos();

    // Set display dimensions.
    chip->width = DISPLAY_WIDTH;
    chip->height = DISPLAY_HEIGHT;

    // Initialize framebuffer.
    chip->framebuffer =
        framebuffer_init(
            &chip->width,
            &chip->height
        );

    // Ensure framebuffer dimensions fit allocation.
    if (chip->width > MAX_DISPLAY_WIDTH ||
        chip->height > MAX_DISPLAY_HEIGHT) {
        free(chip);
        return;
    }

    // Draw initial display.
    draw_reservoir(chip);

    // Initialize timer.
    const timer_config_t timer_config = {
        .callback = timer_callback,
        .user_data = chip,
    };

    chip->timer = timer_init(&timer_config);

    timer_start(
        chip->timer,
        UPDATE_INTERVAL_US,
        true
    );
}
