
#include "wokwi-api.h"
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <stdbool.h>
#include <math.h>

// ============================================================
// DISPLAY CONFIGURATION
// ============================================================

// Logical design dimensions.
// All drawing coordinates below use this 160 x 220 layout.
#define BASE_WIDTH  160
#define BASE_HEIGHT 220

// Actual Wokwi framebuffer/display dimensions.
// Keep these synchronized with reservoir.chip.json.
#define DISPLAY_WIDTH  480
#define DISPLAY_HEIGHT 660

// Maximum framebuffer allocation.
// Must be at least as large as DISPLAY_WIDTH x DISPLAY_HEIGHT.
#define MAX_DISPLAY_WIDTH  480
#define MAX_DISPLAY_HEIGHT 660

// ============================================================
// RESERVOIR CONFIGURATION
// ============================================================

#define TANK_CAPACITY       1000.0f
#define INITIAL_VOLUME       800.0f

#define IRRIGATION_RATE       60.0f
#define REFILL_RATE          120.0f

#define UPDATE_INTERVAL_US  50000

#define LEVEL_MAX_VOLTAGE      3.3f

// ============================================================
// COLOURS
// ============================================================

#define COLOR(r,g,b,a) \
    ((uint32_t)(r) | ((uint32_t)(g) << 8) | \
    ((uint32_t)(b) << 16) | ((uint32_t)(a) << 24))

#define BG_COLOR        COLOR(12, 20, 32, 255)
#define HEADER_COLOR    COLOR(20, 32, 48, 255)

#define FRAME_DARK      COLOR(55, 70, 85, 255)
#define FRAME_MID       COLOR(115, 135, 150, 255)
#define FRAME_LIGHT     COLOR(190, 205, 215, 255)

#define TANK_BG         COLOR(15, 28, 42, 255)

#define WATER_TOP       COLOR(75, 205, 255, 255)
#define WATER_MID       COLOR(20, 135, 220, 255)
#define WATER_BOTTOM    COLOR(5, 65, 155, 255)
#define WATER_HIGHLIGHT COLOR(175, 240, 255, 255)

#define WHITE           COLOR(245, 250, 255, 255)
#define GREY            COLOR(145, 160, 175, 255)

#define GREEN           COLOR(45, 220, 115, 255)
#define RED             COLOR(245, 75, 75, 255)
#define PANEL_COLOR     COLOR(27, 42, 58, 255)

// ============================================================
// CHIP STATE
// ============================================================

typedef struct {
    pin_t irrigation_pin;
    pin_t refill_pin;
    pin_t level_pin;

    buffer_t framebuffer;
    timer_t timer;

    uint32_t width;
    uint32_t height;

    float volume;
    float wave_phase;

    uint64_t last_update;
} chip_state_t;

// ============================================================
// FRAMEBUFFER AND SCALING STATE
// ============================================================

static uint32_t pixels[
    MAX_DISPLAY_WIDTH * MAX_DISPLAY_HEIGHT
];

static float scale_x_factor = 1.0f;
static float scale_y_factor = 1.0f;

static uint32_t render_width = BASE_WIDTH;
static uint32_t render_height = BASE_HEIGHT;

// ============================================================
// FUNCTION DECLARATIONS
// ============================================================

static void draw_pixel(int x, int y, uint32_t color);

static void draw_rect(
    int x1, int y1, int x2, int y2,
    uint32_t color
);

static void draw_line(
    int x1, int y1, int x2, int y2,
    uint32_t color
);

static void draw_text_scaled(
    int x, int y,
    const char *text,
    uint32_t color,
    int scale
);

static void draw_reservoir(chip_state_t *chip);

static void update_reservoir(chip_state_t *chip);

static void timer_callback(void *user_data);

// ============================================================
// COORDINATE SCALING
// ============================================================

static int scaled_x(int x) {
    return (int)(x * scale_x_factor + 0.5f);
}

static int scaled_y(int y) {
    return (int)(y * scale_y_factor + 0.5f);
}

// Low-level pixel writer.
// Coordinates are actual display coordinates.
static void put_pixel(
    int x, int y,
    uint32_t color
) {
    if (x < 0 || x >= (int)render_width ||
        y < 0 || y >= (int)render_height) {
        return;
    }

    pixels[y * render_width + x] = color;
}

// High-level pixel writer.
// Coordinates use the reference design.
static void draw_pixel(
    int x, int y,
    uint32_t color
) {
    put_pixel(
        scaled_x(x),
        scaled_y(y),
        color
    );
}

// ============================================================
// RECTANGLES
// ============================================================

static void draw_rect(
    int x1, int y1,
    int x2, int y2,
    uint32_t color
) {
    if (x1 > x2) {
        int temp = x1;
        x1 = x2;
        x2 = temp;
    }

    if (y1 > y2) {
        int temp = y1;
        y1 = y2;
        y2 = temp;
    }

    int sx1 = scaled_x(x1);
    int sy1 = scaled_y(y1);
    int sx2 = scaled_x(x2);
    int sy2 = scaled_y(y2);

    for (int y = sy1; y <= sy2; y++) {
        for (int x = sx1; x <= sx2; x++) {
            put_pixel(x, y, color);
        }
    }
}

// ============================================================
// LINES
// ============================================================

static void draw_line(
    int x1, int y1,
    int x2, int y2,
    uint32_t color
) {
    int dx = abs(x2 - x1);
    int dy = abs(y2 - y1);

    int sx = (x1 < x2) ? 1 : -1;
    int sy = (y1 < y2) ? 1 : -1;

    int err = dx - dy;

    while (true) {
        draw_pixel(x1, y1, color);

        if (x1 == x2 && y1 == y2) {
            break;
        }

        int e2 = 2 * err;

        if (e2 > -dy) {
            err -= dy;
            x1 += sx;
        }

        if (e2 < dx) {
            err += dx;
            y1 += sy;
        }
    }
}

// ============================================================
// FONT
// ============================================================

static const uint8_t *get_glyph(char c) {

    static const uint8_t blank[5] = {
        0, 0, 0, 0, 0
    };

    static const uint8_t digits[10][5] = {
        {7,5,5,5,7},
        {2,6,2,2,7},
        {7,1,7,4,7},
        {7,1,7,1,7},
        {5,5,7,1,1},
        {7,4,7,1,7},
        {7,4,7,5,7},
        {7,1,1,1,1},
        {7,5,7,5,7},
        {7,5,7,1,7}
    };

    static const uint8_t letters[26][5] = {
        {2,5,7,5,5}, // A
        {6,5,6,5,6}, // B
        {3,4,4,4,3}, // C
        {6,5,5,5,6}, // D
        {7,4,6,4,7}, // E
        {7,4,6,4,4}, // F
        {3,4,5,5,3}, // G
        {5,5,7,5,5}, // H
        {7,2,2,2,7}, // I
        {1,1,1,5,7}, // J
        {5,5,6,5,5}, // K
        {4,4,4,4,7}, // L
        {5,7,7,5,5}, // M
        {5,7,7,7,5}, // N
        {7,5,5,5,7}, // O
        {6,5,6,4,4}, // P
        {7,5,5,7,1}, // Q
        {6,5,6,5,5}, // R
        {3,4,7,1,6}, // S
        {7,2,2,2,2}, // T
        {5,5,5,5,7}, // U
        {5,5,5,5,2}, // V
        {5,5,7,7,5}, // W
        {5,5,2,5,5}, // X
        {5,5,2,2,2}, // Y
        {7,1,2,4,7}  // Z
    };

    if (c >= '0' && c <= '9') {
        return digits[c - '0'];
    }

    if (c >= 'A' && c <= 'Z') {
        return letters[c - 'A'];
    }

    return blank;
}

// ============================================================
// SCALABLE TEXT
// ============================================================

static void draw_text_scaled(
    int x, int y,
    const char *text,
    uint32_t color,
    int scale
) {
    while (*text) {

        const uint8_t *glyph = get_glyph(*text);

        for (int row = 0; row < 5; row++) {
            for (int col = 0; col < 3; col++) {

                if (glyph[row] & (1 << (2 - col))) {

                    draw_rect(
                        x + col * scale,
                        y + row * scale,
                        x + col * scale + scale - 1,
                        y + row * scale + scale - 1,
                        color
                    );
                }
            }
        }

        x += 4 * scale;
        text++;
    }
}

// ============================================================
// HEADER AND VOLUME
// ============================================================

static void draw_header(chip_state_t *chip) {

    draw_rect(
        0, 0,
        BASE_WIDTH - 1, 22,
        HEADER_COLOR
    );

    draw_text_scaled(
        43, 6,
        "RESERVOIR",
        WHITE,
        2
    );

    draw_line(
        8, 22,
        151, 22,
        FRAME_MID
    );

    char volume_text[16];

    snprintf(
        volume_text,
        sizeof(volume_text),
        "%dL",
        (int)(chip->volume + 0.5f)
    );

    int length = 0;

    while (volume_text[length] != '\0') {
        length++;
    }

    int text_width = length * 12;

    int x = (BASE_WIDTH - text_width) / 2;

    draw_text_scaled(
        x, 31,
        volume_text,
        WHITE,
        3
    );
}

